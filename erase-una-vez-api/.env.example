# Copia este archivo como .env y completa los valores (el archivo .env NO se sube a GitHub)

# Cadena de conexión de Supabase (botón Connect > Session pooler). Reemplaza [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Clave secreta para firmar las sesiones (genera una larga y aleatoria, ver README)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES=8h

PORT=3000

# Direcciones permitidas del frontend, separadas por coma
CORS_ORIGIN=http://localhost:5173
